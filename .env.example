# MongoDB (Required for Auth, Users & Real-time Orders)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB_NAME="artisan_haven"

# Auth Secrets & Admin User
AUTH_SECRET="your-super-secret-long-random-string"
ADMIN_EMAIL="vandan11patel@gmail.com"
ADMIN_NAME="Vandan Patel"
ADMIN_PASSWORD="Admin@123"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Configuration (Nodemailer SMTP)
# Automated notifications sent to meivaninfo@gmail.com for order packing & shipping
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="meivaninfo@gmail.com"
SMTP_PASS="your-16-character-gmail-app-password"
SMTP_FROM="Meivan Art <meivaninfo@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="meivaninfo@gmail.com"

# PayU India Online Payment Gateway Integration
# For Test mode use standard test keys; For Live mode provide your PayU Merchant credentials
PAYU_MODE="test" # "test" or "live"
PAYU_MERCHANT_KEY="gtKFFx"
PAYU_MERCHANT_SALT="eCwWELxi"

# Google Sheets Order Logging Integration
# Easiest Setup: Paste your Google Apps Script Webhook URL below (See GOOGLE_SHEET_SETUP.md)
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/AKfycby.../exec"
# Optional direct Sheet ID
GOOGLE_SHEET_ID=""

# Cloudinary Image & Video Storage Configuration (Server & Client)
# Obtain these credentials from your Cloudinary Dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret" # NEVER expose this secret to the browser!

# Optional OpenAI Integration
OPENAI_API_KEY=""

