# Vandan Artwork - Environment Variables Example Configuration

# MongoDB (Required for Auth, Users & Real-time Orders)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB_NAME="artisan_haven"

# Auth Secrets & Admin User
AUTH_SECRET="your-super-secret-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Admin User"
ADMIN_PASSWORD="AdminPassword123"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Configuration (Nodemailer SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="vandanartwork@gmail.com"
SMTP_PASS="your-16-character-gmail-app-password"
SMTP_FROM="Vandan Artwork <vandanartwork@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="vandanartwork@gmail.com"

